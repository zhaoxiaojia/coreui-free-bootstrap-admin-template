extends ../_layout/default.pug

block vars
  - var bodyClass = 'dashboard-page'
  - var wrapperExtraClass = 'dashboard-wrapper'
  - var contentContainerClass = 'container-fluid px-4 px-xl-5 dashboard-content'

block styles
  link(rel='stylesheet', href='node_modules/@coreui/chartjs/dist/css/coreui-chartjs.css')
  link(rel='stylesheet', href='css/dashboard.css')

block scripts
  script(src='node_modules/chart.js/dist/chart.umd.js')
  script(src='node_modules/@coreui/chartjs/dist/js/coreui-chartjs.js')
  script(src='node_modules/@coreui/utils/dist/umd/index.js')
  script(src='node_modules/xlsx/dist/xlsx.full.min.js')
  script(src='js/wifi-dashboard.js')

block breadcrumb
  +breadcrumb(
    [
      { href: '#', label: 'Home'},
      { label: 'Dashboard'}
    ]
  )

block view
  .dashboard-hero.card.border-0.text-white.mb-4
    .card-body.p-4.p-xl-5
      .row.g-4.align-items-center
        .col-lg-8
          h1.display-6.fw-semibold.mb-3 Wi-Fi Performance Command Center
          p.mb-0 Monitor lab throughput, latency, and capacity in real time so teams can spot bottlenecks quickly and focus on the metrics that matter.
        .col-lg-4
          .hero-stats.d-flex.flex-wrap.justify-content-lg-end
            .hero-stat
              span.hero-stat__label SLA Pass Rate
              span.hero-stat__value 98.4%
              span.hero-stat__trend
                svg.icon
                  use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-arrow-circle-top')
                | +2.1%
            .hero-stat
              span.hero-stat__label Last Updated
              span.hero-stat__value 5 minutes ago
  .row.g-4.mb-4
    .col-12.col-sm-6.col-xl-3
      .metric-card.gradient-indigo.h-100
        .metric-icon
          svg.icon
            use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-speedometer')
        .metric-label Realtime Throughput (Tx)
        .metric-value 612 Mbps
        .metric-trend
          svg.icon
            use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-arrow-top')
          | WoW +12%
    .col-12.col-sm-6.col-xl-3
      .metric-card.gradient-pink.h-100
        .metric-icon
          svg.icon
            use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-wifi-signal-4')
        .metric-label Realtime Throughput (Rx)
        .metric-value 588 Mbps
        .metric-trend
          svg.icon
            use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-arrow-top')
          | WoW +9%
    .col-12.col-sm-6.col-xl-3
      .metric-card.gradient-amber.h-100
        .metric-icon
          svg.icon
            use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-layers')
        .metric-label Active Tests
        .metric-value 128 Runs
        .metric-trend
          svg.icon
            use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-calendar')
          | Planned this week 142
    .col-12.col-sm-6.col-xl-3
      .metric-card.gradient-emerald.h-100
        .metric-icon
          svg.icon
            use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-chart-line')
        .metric-label Average Latency
        .metric-value 18 ms
        .metric-trend
          svg.icon
            use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-arrow-bottom')
          | DoD -4%
  .row.g-4
    .col-12.col-xl-4.col-xxl-3
      .card.h-100.card-glass
        .card-header
          h5.mb-0 Filter Controls
        .card-body
          form#filtersForm.row.g-3.align-items-end
            .col-12.col-md-6
              label.form-label(for='filterProductLine') Product Line
              select#filterProductLine.form-select
                option(value='') All Product Lines
            .col-12.col-md-6
              label.form-label(for='filterProject') Project
              select#filterProject.form-select
                option(value='') All Projects
            .col-12.col-md-6
              label.form-label(for='filterTestReport') Test Report
              select#filterTestReport.form-select
                option(value='') All Test Reports
            .col-12.col-md-6
              label.form-label(for='filterStandard') Standard
              select#filterStandard.form-select
                option(value='') All Standards
            .col-12.col-md-6
              label.form-label(for='filterBand') Band
              select#filterBand.form-select
                option(value='') All Bands
            .col-12.col-md-6
              label.form-label(for='filterBandwidth') Bandwidth
              select#filterBandwidth.form-select
                option(value='') All Bandwidths
            .col-12.col-md-6
              label.form-label(for='filterDeviceType') Device Field
              select#filterDeviceType.form-select
                option(value='') All Device Fields
                option(value='adb_device') ADB Device
                option(value='telnet_ip') Telnet IP
            .col-12.col-md-6
              label.form-label(for='filterDeviceValue') Device Value
              select#filterDeviceValue.form-select(disabled)
                option(value='') Select a device field
            .col-12.col-md-6
              label.form-label(for='filterStartDate') Start Date
              input#filterStartDate.form-control(type='date')
            .col-12.col-md-6
              label.form-label(for='filterEndDate') End Date
              input#filterEndDate.form-control(type='date')
            .col-12.d-flex.flex-wrap.gap-2.justify-content-end
              button.btn.btn-outline-secondary(type='reset') Reset
              button.btn.btn-primary(type='submit') Apply Filters
    .col-12.col-xl-8.col-xxl-9
      .card.h-100.card-glass
        .card-header.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
          h5.mb-0 Wi-Fi Performance Overview
          .d-flex.flex-wrap.gap-2
            button#refreshButton.btn.btn-outline-secondary.btn-sm(type='button')
              svg.icon.me-1
                use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-reload')
              | Refresh
            button#exportButton.btn.btn-outline-primary.btn-sm(type='button')
              svg.icon.me-1
                use(xlink:href='node_modules/@coreui/icons/sprites/free.svg#cil-cloud-download')
              | Export
        .card-body.d-flex.flex-column.gap-4
          .status-banner
            p#statusMessage.small.mb-0 Choose filters and click "Apply Filters" to run the query.
          #performanceChartGroups.d-flex.flex-column.gap-4
