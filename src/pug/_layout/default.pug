- var count = 1000
block vars
  - var bodyClass = ''
  - var wrapperExtraClass = ''
  - var contentContainerClass = 'container-lg px-4'

doctype html
include ../_partials/banner.pug
include ../_mixins/breadcrumb.pug
include ../_mixins/callout.pug
include ../_mixins/callout-custom.pug
include ../_mixins/docs-components.pug
include ../_mixins/example.pug

html(lang='en')
  head
    base(href=base)
    include ../_partials/head.pug
    block canonical
    block styles
  body(class=bodyClass)
    include ../_partials/sidebar.pug
    div(class=['wrapper', 'd-flex', 'flex-column', 'min-vh-100', wrapperExtraClass].filter(Boolean).join(' '))
      include ../_partials/header.pug
      .body.flex-grow-1
        div(class=(contentContainerClass || '').trim())
          block view
      include ../_partials/footer.pug
    include ../_partials/scripts.pug
